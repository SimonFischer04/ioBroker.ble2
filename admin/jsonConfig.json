{
    "type": "panel",
    "i18n": true,
    "items": {
        "server": {
            "type": "text",
            "label": "Use remote server:",
            "placeholder": "address:port",
            "help": "when configured, the local bluetooth adapter is not used",
            "trim": false,
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4
        },
        "hciDevice": {
            "type": "selectSendTo",
            "label": "Select device:",
            "help": "On linux this can be determined with `hciconfig`:",
            "command": "getHCIOptions",
            "manual": true,
            "validator": "String(data.hciDevice ?? '').trim() === '' || (/^\\d+$/.test(String(data.hciDevice).trim()) && Number.isSafeInteger(Number(data.hciDevice)))",
            "validatorNoSaveOnError": true,
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4
        },
        "rssiThrottle": {
            "type": "number",
            "label": "RSSI update interval [ms]:",
            "help": "Too frequent updates can slow down the admin.",
            "min": 0,
            "max": 10000,
            "step": 1,
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4
        },
        "services": {
            "type": "text",
            "label": "Monitored services, * for all services:",
            "help": "Service characteristics as HEX codes or UUID, comma separated.",
            "minRows": 3,
            "trim": false,
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 6,
            "xl": 6
        },
        "plugins": {
            "type": "text",
            "hidden": true,
            "onChange": {
                "alsoDependsOn": [
                    "_pluginSelection"
                ],
                "calculateFunc": "(data._pluginSelection || []).join(',')"
            },
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "_pluginSelection": {
            "type": "select",
            "multiple": true,
            "label": "Active plugins:",
            "help": "Select the plugins for your sensors. Basic advertisement data is always available.",
            "doNotSave": true,
            "defaultFunc": "[...new Set((Array.isArray(data.plugins) ? data.plugins : String(data.plugins || '').split(',')).map(p => p.trim().toLowerCase()).filter(p => ['xiaomi', 'mi-flora', 'ruuvi-tag', 'bthome', 'mopeka'].includes(p)))]",
            "options": [
                {
                    "label": "Xiaomi",
                    "value": "xiaomi"
                },
                {
                    "label": "Mi Flora",
                    "value": "mi-flora"
                },
                {
                    "label": "Ruuvi Tag",
                    "value": "ruuvi-tag"
                },
                {
                    "label": "BTHome",
                    "value": "bthome"
                },
                {
                    "label": "Mopeka Pro Check",
                    "value": "mopeka"
                }
            ],
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 6,
            "xl": 6
        },
        "allowEmptyDevices": {
            "type": "checkbox",
            "label": "Allow creation of devices without advertised data",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 6,
            "xl": 6
        },
        "_staleDeviceCleanup": {
            "type": "panel",
            "label": "Remove stale devices",
            "xs": 12,
            "sm": 12,
            "items": {
                "_staleCleanupDays": {
                    "type": "number",
                    "label": "Days since last RSSI update",
                    "default": 56,
                    "min": 1,
                    "max": 3650,
                    "step": 1,
                    "doNotSave": true,
                    "xs": 12,
                    "sm": 4
                },
                "_staleCleanupToken": {
                    "type": "text",
                    "default": "",
                    "hidden": true,
                    "doNotSave": true
                },
                "_previewStaleDeviceCleanup": {
                    "type": "sendTo",
                    "label": "Preview stale devices",
                    "command": "previewStaleDeviceCleanup",
                    "jsonData": "{\"days\":${data._staleCleanupDays}}",
                    "useNative": true,
                    "showProcess": true,
                    "result": {
                        "preview": {
                            "en": "%s stale devices are eligible for deletion. Devices assigned to an enum or with custom states are excluded.",
                            "de": "%s inaktive Geräte können gelöscht werden. Geräte mit Aufzählungszuordnung oder benutzerdefinierten Datenpunkteinstellungen sind ausgenommen."
                        }
                    },
                    "doNotSave": true,
                    "xs": 12,
                    "sm": 4
                },
                "_startStaleDeviceCleanup": {
                    "type": "sendTo",
                    "label": "Delete previewed devices",
                    "command": "startStaleDeviceCleanup",
                    "jsonData": "{\"days\":${data._staleCleanupDays},\"token\":\"${data._staleCleanupToken}\"}",
                    "disabled": "!data._staleCleanupToken",
                    "confirm": {
                        "type": "warning",
                        "title": "Delete previewed devices",
                        "text": "Permanently delete the previewed devices and their states?"
                    },
                    "doNotSave": true,
                    "xs": 12,
                    "sm": 4
                }
            }
        },
        "_discovery": {
            "type": "panel",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 6,
            "xl": 6,
            "items": {
                "_allowNewDevices": {
                    "type": "state",
                    "label": "Accept new devices",
                    "oid": "options.allowNewDevices",
                    "control": "switch",
                    "foreign": false,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_discoveryHelp": {
                    "type": "staticText",
                    "text": "This will be automatically disabled after 5 minutes.",
                    "xs": 12,
                    "style": {
                        "fontSize": 12
                    },
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        }
    }
}
